{
  "name": "group-tabs-by-url",
  "version": "1.1.0",
  "private": true,
  "description": "Firefox add-on: gather tabs whose address matches your rules into tab groups.",
  "license": "MIT",
  "scripts": {
    "start": "web-ext run --source-dir extension",
    "test": "node --test test/rules.test.js test/grouping.test.js",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "web-ext": "^10.8.0"
  }
}
